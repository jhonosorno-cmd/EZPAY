# Hash con sal del PIN del MVP (D5, spec pin-validation). Genera la línea con:
#   python scripts/make_pin_hash.py
# Formato: scrypt$N$r$p$sal_b64$hash_b64. Nunca guardes el PIN en claro aquí,
# ni en el repo, ni en logs. Sin valor por defecto: falla cerrado si falta.
EZPAY_PIN_HASH=

# --- Backend FastAPI (api/app) ---------------------------------------------------------------
# Servicio Node de pagos (Contrato A). Para probar sin wallet: `npm run mock:a` en la raíz (4000).
NODE_BASE_URL=http://localhost:4000/v1
# Moneda y escala de la demo: iguales a VITE_ASSET_CODE / VITE_ASSET_SCALE del frontend.
ASSET_CODE=COP
ASSET_SCALE=2
# Wallet de la usuaria de la demo (la misma WALLET_ADDRESS de payments/.env).
EZPAY_WALLET_ADDRESS=https://ilp.interledger-test.dev/marta
# A dónde vuelve la wallet tras aprobar (la ruta /grant-callback del frontend).
EZPAY_FINISH_URI=http://localhost:5173/grant-callback
# Los contactos se agregan desde la web (pantalla "Mis contactos"; la wallet se valida contra Open
# Payments). Opcional: agenda inicial en JSON con `contacts` (por ejemplo Laura con
# https://ilp.interledger-test.dev/laura), fuera del repo.
EZPAY_AGENDA_PATH=
# Pesos locales de speechbrain/spkrec-ecapa-voxceleb. Sin esto la voz nunca verifica y todo pide PIN.
EZPAY_SPEAKER_MODEL_DIR=
# Transcripción: groq = Groq whisper-large-v3-turbo siempre primero, con faster-whisper local como respaldo
# si Groq falla; auto = Groq solo con el consentimiento del enrolamiento y respaldo local.
# EZPAY_WARMUP_WHISPER=1 baja el modelo local al arrancar, para que el respaldo no espere la descarga.
EZPAY_STT_PROVIDER=groq
GROQ_API_KEY=

# Desafío de voz (B11): con la voz del comando verificada, la confirmación pide repetir una frase del
# banco de Voz (voice/challenge_phrases.json) en vez de "sí". 1 = activo, 0 = "sí" como siempre.
EZPAY_CONFIRMATION_CHALLENGE=1
# Coincidencia mínima de la frase (0 a 1); la fija ML 2 con la calibración en la sala.
EZPAY_CHALLENGE_PHRASE_MATCH_MIN=0.80
